    <slider x="10" y="535" width="240" height="45" display="minimum-reserve" variable="minimum-reserve" min="0" max="500" default="100" step="25" direction="Horizontal" />
    <slider x="10" y="583" width="240" height="45" display="model-seed" variable="model-seed" min="1" max="1000" default="42" step="1" direction="Horizontal" />
    <switch x="10" y="640" width="240" height="35" display="show-balances?" variable="show-balances?" on="false" />
    <note x="10" y="685" width="240" height="105" fontSize="12" markdown="false" textColorLight="-16777216" textColorDark="-1" backgroundLight="0" backgroundDark="0">Compare: choose a mode, click Setup, then +100 ticks.
Keep the same seed and settings.
Labels show cash / e-float.
Full assumptions: Info tab.</note>
    <view x="270" y="90" width="466" height="466" patchSize="14" minPxcor="-16" maxPxcor="16" minPycor="-16" maxPycor="16" wrappingAllowedX="false" wrappingAllowedY="false" updateMode="1" frameRate="15" showTickCounter="true" tickCounterLabel="ticks" fontSize="11" />
    <monitor x="270" y="566" width="112" height="55" display="Value served (%)" precision="1" fontSize="11">percent-served -1</monitor>
    <monitor x="388" y="566" width="112" height="55" display="Requests rescued" precision="0" fontSize="11">rescued-count</monitor>
