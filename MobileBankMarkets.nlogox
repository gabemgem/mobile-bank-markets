<?xml version='1.0' encoding='utf-8'?>
<model version="NetLogo 7.0.3" snapToGrid="true">
  <code><![CDATA[breed [kiosks kiosk]

globals [
  requested-values served-values   ; [deposit withdrawal], in illustrative money units
  requested-count served-count rescued-count
  swap-count swap-value
  tick-served tick-failed tick-swaps
  initial-cash initial-efloat net-customer-cash
]

kiosks-own [cash efloat withdrawal-probability participating?]

to setup
  clear-all
  random-seed model-seed
  set requested-values [0 0]
  set served-values [0 0]
  ask patches [ set pcolor [22 29 40] ]
  create-kiosks number-of-kiosks [
    set cash starting-balance
    set efloat starting-balance
    set withdrawal-probability max list 0 (min list 1
      (withdrawal-share + ifelse-value (who mod 2 = 0)
        [demand-polarization] [(- demand-polarization)]))
    set shape "circle"
    set size 1.6
    set label-color white
  ]
  ; Local randomness keeps topology and participation from changing the demand stream.
  with-local-randomness [
    ask kiosks [ set participating? random-float 100 < participation-percent ]
    ask kiosks [
      create-links-with other kiosks with [who > [who] of myself]
        with [random-float 1 < network-density]
    ]
  ]
  layout-circle sort kiosks (max-pxcor - 3)
  set initial-cash sum [cash] of kiosks
  set initial-efloat sum [efloat] of kiosks
  with-local-randomness [ ask links [ set color [58 70 86] set thickness 0.08 ] ]
  refresh-view
  reset-ticks
end

to go
  set tick-served 0
  set tick-failed 0
  set tick-swaps 0
  with-local-randomness [ ask links [ set color [58 70 86] set thickness 0.08 ] ]
  repeat requests-per-tick [
    ; Generate all demand outside the sharing procedure's local random stream.
    let outlet one-of kiosks
    let amount 1 + random maximum-request
    let withdrawal? random-float 1 < [withdrawal-probability] of outlet
    ask outlet [ serve-request amount withdrawal? ]
  ]
  check-accounting
  refresh-view
  tick
end

to serve-request [amount withdrawal?]
  let kind ifelse-value withdrawal? [1] [0]
  set requested-count requested-count + 1
  set requested-values replace-item kind requested-values
    (item kind requested-values + amount)
  let was-short? resource withdrawal? < amount
  if was-short? [ with-local-randomness [ seek-liquidity amount withdrawal? ] ]
  ifelse resource withdrawal? >= amount [
    let cash-change ifelse-value withdrawal? [(- amount)] [amount]
    shift-balances cash-change
    set net-customer-cash net-customer-cash + cash-change
    set served-count served-count + 1
    set served-values replace-item kind served-values
      (item kind served-values + amount)
    set tick-served tick-served + amount
    if was-short? [ set rescued-count rescued-count + 1 ]
  ] [
    set tick-failed tick-failed + amount
  ]
end

to seek-liquidity [amount cash-needed?]
  if sharing-mode = "No sharing" or not participating? [ stop ]
  let partners other kiosks with [participating?]
  if sharing-mode = "Network sharing" [
    set partners partners with [link-neighbor? myself]
  ]
  let shortfall amount - resource cash-needed?
  ; Both sides protect the resource they give up. No swaps occur unless the
  ; complete customer request can be funded, possibly by several partners.
  if resource (not cash-needed?) - minimum-reserve < shortfall [ stop ]
  set partners partners with [resource cash-needed? > minimum-reserve]
  if sum [resource cash-needed? - minimum-reserve] of partners < shortfall [ stop ]
  foreach shuffle sort partners [partner ->
    if shortfall > 0 [
      let quantity min list shortfall
        ([resource cash-needed?] of partner - minimum-reserve)
      let cash-change ifelse-value cash-needed? [quantity] [(- quantity)]
      shift-balances cash-change
      ask partner [ shift-balances (- cash-change) ]
      set shortfall shortfall - quantity
      set swap-count swap-count + 1
      set swap-value swap-value + quantity
      set tick-swaps tick-swaps + quantity
      let connection link-with partner
      if connection != nobody [
        ask connection [ set color [65 210 185] set thickness 0.3 ]
      ]
    ]
  ]
end

to-report resource [cash?]
  report ifelse-value cash? [cash] [efloat]
end

to shift-balances [cash-change]
  set cash cash + cash-change
  set efloat efloat - cash-change
end

to-report percent-served [kind]
  let demand ifelse-value (kind = -1)
    [sum requested-values] [item kind requested-values]
  let completed ifelse-value (kind = -1)
    [sum served-values] [item kind served-values]
  if demand = 0 [ report 0 ]
  report 100 * completed / demand
end

to refresh-view
  ; Rendering must not consume randomness used to generate customer demand.
  with-local-randomness [
    ask links [
      set hidden? sharing-mode != "Network sharing" or
        not ([participating?] of end1 and [participating?] of end2)
    ]
    ask kiosks [
      let cash-share cash / (cash + efloat)
      set color ifelse-value (cash-share < 0.25) [[235 132 76]]
        [ifelse-value (cash-share > 0.75) [[78 153 232]] [[65 210 185]]]
      set size ifelse-value participating? [1.6] [1.0]
      set label ifelse-value show-balances?
        [(word (round cash) "/" (round efloat))] [""]
    ]
  ]
end

to check-accounting
  if any? kiosks with [cash < 0 or efloat < 0] [ error "Negative kiosk balance." ]
  if abs (sum [cash] of kiosks - initial-cash - net-customer-cash) > 0.000001 [
    error "Cash accounting does not reconcile."
  ]
  if abs (sum [efloat] of kiosks - initial-efloat + net-customer-cash) > 0.000001 [
    error "E-float accounting does not reconcile."
  ]
end
]]></code>
  <widgets>
    <note x="10" y="5" width="1200" height="35" fontSize="22" markdown="false" textColorLight="-16777216" textColorDark="-1" backgroundLight="0" backgroundDark="0">MOBILE MONEY | Liquidity exchange laboratory</note>
