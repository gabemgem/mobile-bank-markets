    <plot x="760" y="320" width="445" height="220" display="Customer demand this tick" xAxis="ticks" yAxis="money units" xMin="0" xMax="100" yMin="0" yMax="100" autoPlotX="true" autoPlotY="true" legend="true">
      <setup />
      <update />
      <pen display="Served" color="-10899396" interval="1.0" mode="0" legend="true">
