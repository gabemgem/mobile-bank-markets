<?xml version='1.0' encoding='utf-8'?>
<model version="NetLogo 7.0.3" snapToGrid="true">
  <code><![CDATA[extensions [csv fetch table]

breed [kiosks kiosk]
breed [transfers transfer]
undirected-link-breed [relationships relationship]
directed-link-breed [trade-routes trade-route]

globals [
  controls-initialized?
  sharing-mode number-of-kiosks starting-balance network-density participation-percent requests-per-tick maximum-request withdrawal-share demand-polarization minimum-reserve model-seed show-balances? low-balance-percent target-balance-percent
  network-source selected-market
  grid-cell-size commission-mode commission-percent commission-min-percent commission-max-percent commission-subsidy-percent
  external-mode external-access-percent external-travel-ticks external-service-delay external-max-amount external-open-ticks external-cycle-ticks  travel-closes-shop? demand-heterogeneity size-heterogeneity
  network-description active-market
  network-cache-source network-cache-catalog network-cache-nodes network-cache-edges
  github-network-base-url network-load-status network-load-token network-load-start
  network-pending-tables network-load-timeout
  desktop-dialog-prompt desktop-dialog-options
  requested-values served-values  ; [deposit withdrawal], in illustrative units
  requested-count served-count tick-served tick-failed
  initiated-count settled-count settled-value tick-settled-value
  trade-attempts unmet-attempts
  cash-low-ticks efloat-low-ticks  ; sums of end-of-tick kiosk observations
  initial-cash initial-efloat net-customer-cash
  external-started external-settled external-value net-external-cash
  closed-kiosk-ticks closure-failed-count closure-failed-value
  cash-failed-count efloat-failed-count
  commissions-earned commissions-paid subsidy-spent peer-distance-total
]

kiosks-own [
  agent-id
  commission-rate earned-commissions paid-commissions
  demand-weight size-factor external-access? away-until
  cash efloat reserved-cash reserved-efloat
  withdrawal-probability participating? pending-transfer traded-this-tick?
]

transfers-own [requester partner quantity cash-needed? due-tick external? commission-fee requester-fee subsidized-fee]

to startup
  initialize-controls
end

to initialize-controls
  set network-source "Synthetic random"
  set selected-market ""
  set github-network-base-url "https://raw.githubusercontent.com/gabemgem/mobile-bank-markets/main/synthetic-networks"
  set network-load-timeout 30
  clear-network-cache
  set sharing-mode "Network sharing"
  set number-of-kiosks 20
  set starting-balance 500
  set network-density 0.2
  set participation-percent 100
  set requests-per-tick 40
  set maximum-request 100
  set withdrawal-share 0.5
  set demand-polarization 0.35
  set minimum-reserve 100
  set model-seed 42
  set show-balances? false
  set low-balance-percent 25
  set target-balance-percent 50
  set external-mode "Peers then external"
  set external-access-percent 100
  set external-travel-ticks 3
  set external-service-delay 1
  set external-max-amount 500
  set external-open-ticks 8
  set external-cycle-ticks 12
  set travel-closes-shop? true
  set demand-heterogeneity 1
  set size-heterogeneity 0.5
  set grid-cell-size 5
  set commission-mode "Uniform"
  set commission-percent 1
  set commission-min-percent 0.5
  set commission-max-percent 1.5
  set commission-subsidy-percent 0
  set controls-initialized? true
end

to-report parameter-names
  report ["network-source" "selected-market" "sharing-mode" "number-of-kiosks" "starting-balance" "network-density" "participation-percent" "requests-per-tick" "maximum-request" "withdrawal-share" "demand-polarization" "minimum-reserve" "model-seed" "show-balances?" "low-balance-percent" "target-balance-percent" "external-mode" "external-access-percent" "external-travel-ticks" "external-service-delay" "external-max-amount" "external-open-ticks" "external-cycle-ticks" "travel-closes-shop?" "demand-heterogeneity" "size-heterogeneity" "grid-cell-size" "commission-mode" "commission-percent" "commission-min-percent" "commission-max-percent" "commission-subsidy-percent"]
end

to interface-setup
  if controls-initialized? != true [ initialize-controls ]
  sync-network-source
  if network-source = "GitHub synthetic" [
    if normalized-network-url (runresult "ui-github-base-url") != github-network-base-url [
      error "The library URL changed. Click Load GitHub library before Setup."
    ]
    set selected-market runresult "ui-github-network-id"
  ]
  ; UI bindings are evaluated only here, so core code compiles without widgets.
  set sharing-mode runresult "ui-sharing-mode"
  set number-of-kiosks runresult "ui-number-of-kiosks"
  set starting-balance runresult "ui-starting-balance"
  set network-density runresult "ui-network-density"
  set participation-percent runresult "ui-participation-percent"
  set requests-per-tick runresult "ui-requests-per-tick"
  set maximum-request runresult "ui-maximum-request"
  set withdrawal-share runresult "ui-withdrawal-share"
  set demand-polarization runresult "ui-demand-polarization"
  set minimum-reserve runresult "ui-minimum-reserve"
  set model-seed runresult "ui-model-seed"
  set show-balances? runresult "ui-show-balances?"
  set low-balance-percent runresult "ui-low-balance-percent"
  set target-balance-percent runresult "ui-target-balance-percent"
  set external-mode runresult "ui-external-mode"
  set external-access-percent runresult "ui-external-access-percent"
  set external-travel-ticks runresult "ui-external-travel-ticks"
  set external-service-delay runresult "ui-external-service-delay"
  set external-max-amount runresult "ui-external-max-amount"
  set external-open-ticks runresult "ui-external-open-ticks"
  set external-cycle-ticks runresult "ui-external-cycle-ticks"
  set travel-closes-shop? runresult "ui-travel-closes-shop?"
  set demand-heterogeneity runresult "ui-demand-heterogeneity"
  set size-heterogeneity runresult "ui-size-heterogeneity"
  set grid-cell-size runresult "ui-grid-cell-size"
  set commission-mode runresult "ui-commission-mode"
  set commission-percent runresult "ui-commission-percent"
  set commission-min-percent runresult "ui-commission-min-percent"
  set commission-max-percent runresult "ui-commission-max-percent"
  set commission-subsidy-percent runresult "ui-commission-subsidy-percent"
  setup
end

to interface-go
  set show-balances? runresult "ui-show-balances?"
  go
end

to sync-network-source
  let selection runresult "ui-network-source"
  if selection != network-source [
    set network-source selection
    set selected-market ""
    clear-network-cache
  ]
end

to interface-choose-local-network
  sync-network-source
  choose-local-network
end

to-report network-sources
  report ["Synthetic random" "Observed mutual willingness" "Imported synthetic" "GitHub synthetic"]
end

to interface-load-github
  if controls-initialized? != true [ initialize-controls ]
  set github-network-base-url runresult "ui-github-base-url"
  set selected-market runresult "ui-github-network-id"
  run "set ui-network-source \"GitHub synthetic\""
  load-github-networks
end

to interface-use-random
  use-random-networks
  run "set ui-network-source \"Synthetic random\""
end

to use-random-networks
  set network-source "Synthetic random"
  set selected-market ""
  clear-network-cache
end

to-report normalized-network-url [address]
  if not is-string? address [ report "" ]
  while [not empty? address and last address = "/"] [
    set address but-last address
  ]
  report address
end

to load-github-networks
  if controls-initialized? != true [ initialize-controls ]
  begin-github-load github-network-base-url
  if network-load-status != "Loading" [ stop ]
  let token network-load-token
  let base-url github-network-base-url
  let files ["networks.csv" "nodes.csv" "edges.csv"]
  foreach (range 3) [index ->
    if token = network-load-token [
      let address (word base-url "/" (item index files))
      carefully [
        fetch:url-async address [text -> receive-network-file token index text]
      ] [
        fail-network-load token (word "Download failed: " (item index files) ". " error-message)
      ]
    ]
  ]
end

to begin-github-load [address]
  clear-network-cache
  set network-source "GitHub synthetic"
  set active-market ""
  set github-network-base-url normalized-network-url address
  if not ((position "https://" github-network-base-url = 0) or
          (position "http://" github-network-base-url = 0)) [
    set network-load-status "Error: use a public HTTP(S) directory URL."
    stop
  ]
  set network-load-status "Loading"
  set network-load-start timer
end

to receive-network-file [token index text]
  ; Late responses from cancelled, superseded, or timed-out requests are discarded.
  check-network-load-timeout
  if token != network-load-token or network-load-status != "Loading" [ stop ]
  carefully [
    let rows csv:from-string text
    let headers [["network_id" "network_type"] ["network_id" "node_id"] ["network_id" "source" "target"]]
    check-network-header rows (item index headers)
    set network-pending-tables replace-item index network-pending-tables rows
    if not member? [] network-pending-tables [
      let catalog item 0 network-pending-tables
      validate-network-tables catalog (item 1 network-pending-tables) (item 2 network-pending-tables)
      let ids map [row -> item 0 row] (but-first catalog)
      ; Publish the three tables together; Setup never sees a partial download.
      set network-cache-catalog catalog
      set network-cache-nodes but-first (item 1 network-pending-tables)
      set network-cache-edges but-first (item 2 network-pending-tables)
      set network-cache-source github-network-base-url
      set network-pending-tables (list [] [] [])
      set network-load-status (word "Ready: " length ids " GitHub graphs")
    ]
  ] [
    fail-network-load token (word "Invalid network CSV: " error-message)
  ]
end

to fail-network-load [token message]
  if token != network-load-token [ stop ]
  clear-network-cache
  set network-load-status (word "Error: " message)
end

to cancel-network-load
  clear-network-cache
  set network-load-status "Cancelled. Reload the library or use random networks."
end

to check-network-load-timeout
  if network-load-status = "Loading" [
    if timer - network-load-start >= network-load-timeout [
      fail-network-load network-load-token "Download timed out. Check the raw URL, HTTP errors, and CORS, then retry."
    ]
  ]
end

to-report network-library-status
  check-network-load-timeout
  ifelse network-load-status = "Loading"
    [ report (word "Loading: " length filter [rows -> not empty? rows] network-pending-tables " / 3 files") ]
    [ report network-load-status ]
end

to-report import-directory
  report ifelse-value (network-source = "Observed mutual willingness")
    ["data"] ["synthetic-networks"]
end

to-report local-catalog
  ensure-network-library
  report but-first network-cache-catalog
end

to clear-network-cache
  set network-cache-source ""
  set network-cache-catalog []
  set network-cache-nodes []
  set network-cache-edges []
  set network-pending-tables (list [] [] [])
  set network-load-token (list new-seed timer)
  set network-load-status "No library loaded"
end

to reload-network-library
  if network-source = "GitHub synthetic" [ load-github-networks stop ]
  clear-network-cache
  if network-source != "Synthetic random" [ ensure-network-library ]
end

to ensure-network-library
  if network-source = "GitHub synthetic" [
    check-network-load-timeout
    if network-cache-source != github-network-base-url or empty? network-cache-catalog [
      error (word network-load-status ". Click Load GitHub library and wait for Ready before Setup.")
    ]
    stop
  ]
  let folder import-directory
  if network-cache-source = folder [ stop ]
  clear-network-cache
  foreach ["networks.csv" "nodes.csv" "edges.csv"] [filename ->
    if not desktop-file-exists? (word folder "/" filename) [
      error (word "Missing local network file: " folder "/" filename
        ". Choose Synthetic random to run without data.")
    ]
  ]
  let catalog desktop-csv (word folder "/networks.csv")
  let nodes desktop-csv (word folder "/nodes.csv")
  let edges desktop-csv (word folder "/edges.csv")
  check-network-header catalog ["network_id" "network_type"]
  check-network-header nodes ["network_id" "node_id"]
  check-network-header edges ["network_id" "source" "target"]
  validate-network-tables catalog nodes edges
  set network-cache-catalog catalog
  set network-cache-nodes but-first nodes
  set network-cache-edges but-first edges
  set network-cache-source folder
  set network-load-status (word "Ready: " length but-first catalog " local graphs")
end

to-report desktop-file-exists? [path]
  ; Deferred desktop primitives let the shared model compile in NetLogo Web.
  report runresult (word "file-exists? \"" path "\"")
end

to-report desktop-csv [path]
  report runresult (word "csv:from-file \"" path "\"")
end

to-report desktop-choice [prompt options]
  set desktop-dialog-prompt prompt
  set desktop-dialog-options options
  let selection runresult "user-one-of desktop-dialog-prompt desktop-dialog-options"
  set desktop-dialog-prompt ""
  set desktop-dialog-options []
  report selection
end

to check-network-header [rows required-columns]
  if empty? rows [ error "Network CSV has no header." ]
  if length first rows < length required-columns [ error "Network CSV header is incomplete." ]
  if sublist (first rows) 0 (length required-columns) != required-columns [
    error (word "Network CSV must start with columns " required-columns)
  ]
end

to validate-network-tables [catalog nodes edges]
  ; Linear-time validation keeps malformed or partial remote libraries out of the cache.
  let graphs table:make
  let vertices table:make
  let ties table:make
  let populations table:make
  foreach (but-first catalog) [row ->
    check-network-row row 2
    let id item 0 row
    if table:has-key? graphs id [ error "Duplicate graph ID in network catalog." ]
    table:put graphs id true
  ]
  if table:length graphs = 0 [ error "The network catalog contains no graphs." ]
  foreach (but-first nodes) [row ->
    check-network-row row 2
    let graph item 0 row
    let key (list graph (item 1 row))
    if not table:has-key? graphs graph [ error "Node belongs to an unknown graph." ]
    if table:has-key? vertices key [ error "Duplicate imported node ID." ]
    table:put vertices key true
    table:put populations graph (1 + ifelse-value (table:has-key? populations graph) [table:get populations graph] [0])
  ]
  foreach (table:keys graphs) [graph ->
    if not table:has-key? populations graph [ error "A catalog graph has no nodes." ]
  ]
  foreach (but-first edges) [row ->
    check-network-row row 3
    let graph item 0 row
    let source item 1 row
    let target item 2 row
    if not table:has-key? vertices (list graph source) or
       not table:has-key? vertices (list graph target) [ error "Network edge refers to a missing node." ]
    if source = target [ error "Imported networks cannot contain self-links." ]
    let key (list graph (sort (list source target)))
    if table:has-key? ties key [ error "Duplicate undirected network edge." ]
    table:put ties key true
  ]
end

to check-network-row [row columns]
  if length row < columns [ error "Incomplete network CSV row." ]
  foreach (sublist row 0 columns) [value ->
    if not is-string? value [ error "Network identifiers and types must be strings." ]
    if empty? value [ error "Empty network identifier or type." ]
  ]
end

to choose-local-network
  if network-source = "GitHub synthetic" [
    error "For GitHub networks, enter the graph ID in ui-github-network-id, then click Setup."
  ]
  if network-source = "Synthetic random" [
    user-message "Synthetic random needs no files. Select an imported source first to choose a local network."
    stop
  ]
  reload-network-library
  let catalog local-catalog
  if empty? catalog [ user-message "The network catalog is empty." stop ]
  ; Optional metadata keeps large synthetic libraries easy to browse.
  if network-source = "Imported synthetic" [
    let generator-column position "generator" first network-cache-catalog
    if generator-column != false [
      let choices sort remove-duplicates map [row -> item generator-column row] catalog
      let selection desktop-choice "Synthetic generator" choices
      if selection = false [ stop ]
      set catalog filter [row -> item generator-column row = selection] catalog
    ]
    let size-column position "n_nodes" first network-cache-catalog
    if size-column != false [
      let sizes sort remove-duplicates map [row -> item size-column row] catalog
      let selection desktop-choice "Number of kiosks" (map [n -> word n ""] sizes)
      if selection = false [ stop ]
      set catalog filter [row -> (word (item size-column row) "") = selection] catalog
    ]
  ]
  let ids map [row -> item 0 row] catalog
  let selection desktop-choice "Local network (private; not saved in model code)" ids
  if selection != false [ set selected-market selection ]
end

to setup
  if controls-initialized? != true [ initialize-controls ]
  if not member? network-source network-sources [ set network-source "Synthetic random" ]
  if not is-string? selected-market [ set selected-market "" ]
  if network-source = "Synthetic random" [ clear-network-cache ]
  if network-source != "Synthetic random" [ ensure-network-library ]
  validate-controls
  let saved-controls map [name -> runresult name] parameter-names
  let saved-library (list network-cache-source network-cache-catalog network-cache-nodes network-cache-edges)
  let saved-loader (list github-network-base-url network-load-status network-load-token
    network-load-start network-pending-tables network-load-timeout)
  clear-all
  set network-cache-source item 0 saved-library
  set network-cache-catalog item 1 saved-library
  set network-cache-nodes item 2 saved-library
  set network-cache-edges item 3 saved-library
  set github-network-base-url item 0 saved-loader
  set network-load-status item 1 saved-loader
  set network-load-token item 2 saved-loader
  set network-load-start item 3 saved-loader
  set network-pending-tables item 4 saved-loader
  set network-load-timeout item 5 saved-loader
  set network-source item 0 saved-controls
  set selected-market item 1 saved-controls
  set sharing-mode item 2 saved-controls
  set number-of-kiosks item 3 saved-controls
  set starting-balance item 4 saved-controls
  set network-density item 5 saved-controls
  set participation-percent item 6 saved-controls
  set requests-per-tick item 7 saved-controls
  set maximum-request item 8 saved-controls
  set withdrawal-share item 9 saved-controls
  set demand-polarization item 10 saved-controls
  set minimum-reserve item 11 saved-controls
  set model-seed item 12 saved-controls
  set show-balances? item 13 saved-controls
  set low-balance-percent item 14 saved-controls
  set target-balance-percent item 15 saved-controls
  set external-mode item 16 saved-controls
  set external-access-percent item 17 saved-controls
  set external-travel-ticks item 18 saved-controls
  set external-service-delay item 19 saved-controls
  set external-max-amount item 20 saved-controls
  set external-open-ticks item 21 saved-controls
  set external-cycle-ticks item 22 saved-controls
  set travel-closes-shop? item 23 saved-controls
  set demand-heterogeneity item 24 saved-controls
  set size-heterogeneity item 25 saved-controls
  set grid-cell-size item 26 saved-controls
  set commission-mode item 27 saved-controls
  set commission-percent item 28 saved-controls
  set commission-min-percent item 29 saved-controls
  set commission-max-percent item 30 saved-controls
  set commission-subsidy-percent item 31 saved-controls
  set controls-initialized? true
  random-seed model-seed
  set requested-values [0 0]
  set served-values [0 0]
  ask patches [ set pcolor [22 29 40] ]
  ifelse network-source != "Synthetic random" [
    load-market-network
  ] [
    create-kiosks number-of-kiosks [ set agent-id word "synthetic-" who ]
    set active-market ""
    set network-description "Synthetic: undirected Erdos-Renyi"
  ]
  ask kiosks [
    set cash starting-balance
    set efloat starting-balance
    set pending-transfer nobody
    set traded-this-tick? false
    set withdrawal-probability max list 0 (min list 1
      (withdrawal-share + ifelse-value (who mod 2 = 0)
        [demand-polarization] [(- demand-polarization)]))
    set shape "circle"
    set label-color white
  ]
  with-local-randomness [
    ask kiosks [ set participating? random-float 100 < participation-percent ]
    if network-source = "Synthetic random" [
      ask kiosks [
        create-relationships-with other kiosks with [who > [who] of myself]
          with [random-float 1 < network-density]
      ]
    ]
    ask relationships [ set color [58 70 86] set thickness 0.08 ]
  ]
  initialize-demand-profiles
  initialize-commissions
  initialize-spatial-layout
  set initial-cash sum [cash] of kiosks
  set initial-efloat sum [efloat] of kiosks
  reset-ticks
  refresh-view
end

to load-market-network
  let catalog local-catalog
  if empty? catalog [ error "Local network catalog is empty." ]
  if selected-market = "" [ set selected-market item 0 first catalog ]
  let entries filter [row -> item 0 row = selected-market] catalog
  if length entries != 1 [ error "Choose a network ID that occurs once in the local catalog." ]
  let nodes filter [row -> item 0 row = selected-market]
    network-cache-nodes
  if empty? nodes [ error "Selected network has no exported nodes." ]
  foreach nodes [row ->
    if any? kiosks with [agent-id = item 1 row] [ error "Duplicate imported node ID." ]
    create-kiosks 1 [ set agent-id item 1 row ]
  ]
  let edges filter [row -> item 0 row = selected-market]
    network-cache-edges
  foreach edges [row ->
    let source one-of kiosks with [agent-id = item 1 row]
    let target one-of kiosks with [agent-id = item 2 row]
    if source = nobody or target = nobody [ error "Network edge refers to a missing node." ]
    if source = target [ error "Imported networks cannot contain self-links." ]
    ask source [
      if relationship-neighbor? target [ error "Duplicate undirected network edge." ]
      create-relationship-with target
    ]
  ]
  set active-market selected-market
  set network-description (word (item 1 first entries) ": " selected-market)
end

to go
  if network-source = "GitHub synthetic" [
    ensure-network-library
    if active-market != selected-market [ error "Click Setup to initialize the selected GitHub graph before running." ]
  ]
  validate-controls
  set tick-served 0
  set tick-failed 0
  set tick-settled-value 0
  ; Keep matching, hidden transfer agents, and display work off the demand stream.
  with-local-randomness [
    ask kiosks [ set traded-this-tick? false ]
    ask relationships [ set color [58 70 86] set thickness 0.08 ]
    ask transfers with [due-tick <= ticks] [ settle-transfer ]
    ask kiosks [ rebalance ]
  ]
  foreach customer-requests [request ->
    ask item 0 request [ serve-request (item 1 request) (item 2 request) ]
  ]
  set closed-kiosk-ticks closed-kiosk-ticks + count kiosks with [away?]
  set cash-low-ticks cash-low-ticks + count kiosks with [low-balance? true]
  set efloat-low-ticks efloat-low-ticks + count kiosks with [low-balance? false]
  check-accounting
  refresh-view
  tick
end

to-report model-version
  report "v2"
end

to initialize-demand-profiles
  ; Separate, stable node-order draws keep profiles independent of policy and topology.
  with-local-randomness [
    random-seed ((model-seed + 7919) mod 2147483647)
    foreach sort kiosks [outlet ->
      ask outlet [
        let volume-draw random-normal 0 1
        let size-draw random-normal 0 1
        set demand-weight exp (demand-heterogeneity * volume-draw)
        set size-factor exp (size-heterogeneity * size-draw)
        set external-access? random-float 100 < external-access-percent
        set away-until 0
      ]
    ]
  ]
  with-local-randomness [
    let mean-weight mean [demand-weight] of kiosks
    ask kiosks [ set demand-weight demand-weight / mean-weight ]
    ; Keep expected transaction size constant, weighting by expected request arrivals.
    let mean-size sum [demand-weight * size-factor] of kiosks / count kiosks
    ask kiosks [ set size-factor size-factor / mean-size ]
  ]
end

to-report external-open?
  report (ticks mod external-cycle-ticks) < external-open-ticks
end

to-report away?
  report travel-closes-shop? and ticks < away-until
end

to book-external-transfer [amount needs-cash?]
  let outlet self
  reserve-resource (not needs-cash?) amount
  set away-until ticks + external-travel-ticks + external-service-delay
  hatch-transfers 1 [
    set hidden? true
    set external? true
    set requester outlet
    set partner nobody
    set quantity amount
    set cash-needed? needs-cash?
    set due-tick ticks + external-travel-ticks + external-service-delay
    ask requester [ set pending-transfer myself set traded-this-tick? true ]
    set external-started external-started + 1
    if due-tick = ticks [ settle-transfer ]
  ]
end

to-report customer-requests
  let outlets sort kiosks
  let batch []
  let weights map [outlet -> [demand-weight] of outlet] outlets
  let total sum weights
  ; Demand is exogenous: closures and policy choices never redirect this stream.
  with-local-randomness [
    random-seed ((model-seed + 104729 * ticks) mod 2147483647)
    repeat requests-per-tick [
      let index 0
      ifelse demand-heterogeneity = 0 [
        set index random length outlets
      ] [
        let draw random-float total
        while [index < length outlets - 1 and draw >= item index weights] [
          set draw draw - item index weights
          set index index + 1
        ]
      ]
      let outlet item index outlets
      let amount (1 + random maximum-request) * [size-factor] of outlet
      let withdrawal? random-float 1 < [withdrawal-probability] of outlet
      set batch lput (list outlet amount withdrawal?) batch
    ]
  ]
  report batch
end

to initialize-commissions
  with-local-randomness [
    random-seed ((model-seed + 67867967) mod 2147483647)
    foreach sort kiosks [outlet ->
      ask outlet [
        set commission-rate ifelse-value (commission-mode = "Uniform")
          [commission-percent / 100]
          [(commission-min-percent + random-float (commission-max-percent - commission-min-percent)) / 100]
      ]
    ]
  ]
end

to initialize-spatial-layout
  ; Freeze a seeded synthetic geography before any trading; policy never moves kiosks.
  with-local-randomness [
    random-seed ((model-seed + 15485863) mod 2147483647)
    layout-circle sort kiosks (max-pxcor - 3)
    repeat 200 [ layout-spring kiosks relationships 0.2 4 1 ]
    let middle-x (min [xcor] of kiosks + max [xcor] of kiosks) / 2
    let middle-y (min [ycor] of kiosks + max [ycor] of kiosks) / 2
    let span max (list (max [xcor] of kiosks - min [xcor] of kiosks)
      (max [ycor] of kiosks - min [ycor] of kiosks))
    ifelse span > 0 [
      let scale 2 * (max-pxcor - 2) / span
      ask kiosks [ setxy ((xcor - middle-x) * scale) ((ycor - middle-y) * scale) ]
    ] [ ask kiosks [ setxy 0 0 ] ]
    ask patches [
      let column floor ((pxcor - min-pxcor) / grid-cell-size)
      let row floor ((pycor - min-pycor) / grid-cell-size)
      set pcolor ifelse-value ((column + row) mod 2 = 0) [[22 29 40]] [[31 42 57]]
    ]
    ; Cell borders sit between patches; this temporary pen has no model role.
    create-turtles 1 [
      hide-turtle
      set color [75 90 109]
      set pen-size 0.5
      let left-edge min-pxcor - 0.4999
      let right-edge max-pxcor + 0.4999
      let bottom-edge min-pycor - 0.4999
      let top-edge max-pycor + 0.4999
      let boundary min-pxcor - 0.5 + grid-cell-size
      while [boundary < right-edge] [
        pen-up setxy boundary bottom-edge pen-down setxy boundary top-edge
        set boundary boundary + grid-cell-size
      ]
      set boundary min-pycor - 0.5 + grid-cell-size
      while [boundary < top-edge] [
        pen-up setxy left-edge boundary pen-down setxy right-edge boundary
        set boundary boundary + grid-cell-size
      ]
      pen-up die
    ]
  ]
end

to-report grid-distance-to [other-outlet]
  let column floor ((xcor - min-pxcor + 0.5) / grid-cell-size)
  let row floor ((ycor - min-pycor + 0.5) / grid-cell-size)
  let other-column floor (([xcor] of other-outlet - min-pxcor + 0.5) / grid-cell-size)
  let other-row floor (([ycor] of other-outlet - min-pycor + 0.5) / grid-cell-size)
  report abs (column - other-column) + abs (row - other-row)
end

to-report peer-trade-amount [supplier needs-cash?]
  let desired (balance-level target-balance-percent) - available needs-cash?
  let own-rate [commission-rate] of supplier * (1 - commission-subsidy-percent / 100)
  let budget max list 0 ((available (not needs-cash?)) - minimum-reserve)
  ; Cash buyers pay from incoming cash; e-float buyers must fund cash plus commission.
  let refill ifelse-value needs-cash? [desired / (1 - own-rate)] [desired]
  if not needs-cash? [ set budget budget / (1 + own-rate) ]
  report max list 0 (min (list refill budget ([available needs-cash?] of supplier - minimum-reserve)))
end

to rebalance
  if pending-transfer != nobody or traded-this-tick? or away? [ stop ]
  if not low-balance? true and not low-balance? false [ stop ]
  let needs-cash? low-balance? true
  let desired (balance-level target-balance-percent) - available needs-cash?
  let budget max list 0 ((available (not needs-cash?)) - minimum-reserve)
  if external-mode != "External only" and sharing-mode != "No sharing" and participating? [
    set trade-attempts trade-attempts + 1
    let partners other kiosks with [free-to-trade? and available needs-cash? > minimum-reserve]
    if sharing-mode = "Network sharing" [
      set partners partners with [relationship-neighbor? myself]
    ]
    let feasible filter [candidate -> peer-trade-amount candidate needs-cash? > 0.000000001] sort partners
    if not empty? feasible [
      let nearest min map [candidate -> grid-distance-to candidate] feasible
      let nearby filter [candidate -> grid-distance-to candidate = nearest] feasible
      let cheapest min map [candidate -> [commission-rate] of candidate] nearby
      let tied filter [candidate -> [commission-rate] of candidate = cheapest] nearby
      let counterparty one-of tied
      book-transfer counterparty (peer-trade-amount counterparty needs-cash?) needs-cash?
      stop
    ]
    set unmet-attempts unmet-attempts + 1
  ]
  if external-mode != "Disabled" and external-access? and external-open? and budget > 0 [
    let amount min (list desired budget external-max-amount)
    if amount > 0 [ book-external-transfer amount needs-cash? ]
  ]
end

to book-transfer [counterparty amount needs-cash?]
  let outlet self
  let trip grid-distance-to counterparty
  let fee amount * [commission-rate] of counterparty
  let subsidy fee * commission-subsidy-percent / 100
  let own-fee fee - subsidy
  reserve-resource (not needs-cash?) amount
  if not needs-cash? [ reserve-resource true own-fee ]
  ask counterparty [ reserve-resource needs-cash? amount ]
  set away-until ticks + trip
  hatch-transfers 1 [
    set hidden? true
    set requester outlet
    set partner counterparty
    set quantity amount
    set cash-needed? needs-cash?
    set external? false
    set commission-fee fee
    set requester-fee own-fee
    set subsidized-fee subsidy
    set due-tick ticks + trip
    ask (turtle-set requester partner) [
      set pending-transfer myself
      set traded-this-tick? true
    ]
    set initiated-count initiated-count + 1
    set peer-distance-total peer-distance-total + trip
    if due-tick = ticks [ settle-transfer ]
  ]
end

to settle-transfer
  let amount quantity
  let needs-cash? cash-needed?
  let external-exchange? external?
  let fee commission-fee
  let paid requester-fee
  let subsidy subsidized-fee
  let cash-change ifelse-value needs-cash? [amount] [(- amount)]
  ask requester [
    reserve-resource (not needs-cash?) (- amount)
    if not external-exchange? and not needs-cash? [ reserve-resource true (- paid) ]
    shift-balances cash-change
    if not external-exchange? [
      set cash cash - paid
      set paid-commissions paid-commissions + paid
    ]
    set pending-transfer nobody
  ]
  ifelse external-exchange? [
    set external-settled external-settled + 1
    set external-value external-value + amount
    set net-external-cash net-external-cash + cash-change
  ] [
    ask partner [
      reserve-resource needs-cash? (- amount)
      shift-balances (- cash-change)
      set cash cash + fee
      set earned-commissions earned-commissions + fee
      set pending-transfer nobody
    ]
    set commissions-earned commissions-earned + fee
    set commissions-paid commissions-paid + paid
    set subsidy-spent subsidy-spent + subsidy
    let connection [relationship-with [partner] of myself] of requester
    if connection != nobody [
      ask connection [ set color [65 210 185] set thickness 0.3 ]
    ]
    set settled-count settled-count + 1
    set settled-value settled-value + amount
    set tick-settled-value tick-settled-value + amount
  ]
  die
end

to serve-request [amount withdrawal?]
  let kind ifelse-value withdrawal? [1] [0]
  set requested-count requested-count + 1
  set requested-values replace-item kind requested-values
    (item kind requested-values + amount)
  if away? [
    set closure-failed-count closure-failed-count + 1
    set closure-failed-value closure-failed-value + amount
    set tick-failed tick-failed + amount
    stop
  ]
  ifelse available withdrawal? >= amount [
    let cash-change ifelse-value withdrawal? [(- amount)] [amount]
    shift-balances cash-change
    set net-customer-cash net-customer-cash + cash-change
    set served-count served-count + 1
    set served-values replace-item kind served-values
      (item kind served-values + amount)
    set tick-served tick-served + amount
  ] [
    ifelse withdrawal? [ set cash-failed-count cash-failed-count + 1 ]
      [ set efloat-failed-count efloat-failed-count + 1 ]
    set tick-failed tick-failed + amount
  ]
end

to-report available [cash?]
  report ifelse-value cash? [cash - reserved-cash] [efloat - reserved-efloat]
end

to-report balance-level [percent]
  report (cash + efloat) * percent / 100
end

to-report low-balance? [cash?]
  report available cash? < balance-level low-balance-percent
end

to-report free-to-trade?
  report participating? and pending-transfer = nobody and not traded-this-tick? and not away?
end

to reserve-resource [cash? amount]
  ifelse cash? [ set reserved-cash reserved-cash + amount ]
    [ set reserved-efloat reserved-efloat + amount ]
end

to shift-balances [cash-change]
  set cash cash + cash-change
  set efloat efloat - cash-change
end

to-report percent-served [kind]
  let demand ifelse-value (kind = -1)
    [sum requested-values] [item kind requested-values]
  let completed ifelse-value (kind = -1)
    [sum served-values] [item kind served-values]
  if demand = 0 [ report 0 ]
  report 100 * completed / demand
end

to validate-controls
  if grid-cell-size < 1 or grid-cell-size > world-width or grid-cell-size != floor grid-cell-size [
    error "Grid cell size must be a whole patch count from 1 to the world width."
  ]
  if not member? commission-mode ["Uniform" "Varied"] [ error "Invalid commission mode." ]
  foreach (list commission-percent commission-min-percent commission-max-percent) [rate ->
    if rate < 0 or rate >= 100 [ error "Commission rates must be at least zero and below 100 percent." ]
  ]
  if commission-min-percent > commission-max-percent or commission-subsidy-percent < 0 or commission-subsidy-percent > 100 [
    error "Invalid commission bounds or subsidy share."
  ]
  if not member? external-mode ["Disabled" "External only" "Peers then external"] [ error "Invalid external mode." ]
  if external-cycle-ticks < 1 or external-cycle-ticks != floor external-cycle-ticks or
    external-open-ticks < 0 or external-open-ticks > external-cycle-ticks or external-open-ticks != floor external-open-ticks [
    error "External opening ticks must be an integer from zero to the positive cycle length."
  ]
  foreach (list external-travel-ticks external-service-delay) [delay ->
    if delay < 0 or delay != floor delay [ error "Travel and service delays must be nonnegative whole ticks." ]
  ]
  if external-access-percent < 0 or external-access-percent > 100 or external-max-amount <= 0 or
    demand-heterogeneity < 0 or demand-heterogeneity > 2 or size-heterogeneity < 0 or size-heterogeneity > 2 [
    error "Invalid external access, transaction limit, or demand heterogeneity."
  ]
  if target-balance-percent <= low-balance-percent [
    error "Target balance (%) must exceed low balance (%)."
  ]
end

to refresh-view
  with-local-randomness [
    ask trade-routes [ die ]
    ask relationships [
      set hidden? sharing-mode != "Network sharing" or
        not ([participating?] of end1 and [participating?] of end2)
    ]
    ask kiosks [
      set color ifelse-value (low-balance? true) [[235 132 76]]
        [ifelse-value (low-balance? false) [[78 153 232]] [[65 210 185]]]
      if pending-transfer != nobody and [external?] of pending-transfer [ set color [176 130 235] ]
      if away? [ set color [155 164 176] ]
      set size ifelse-value participating? [1.6] [1.0]
      set shape ifelse-value (pending-transfer != nobody) ["circle 2"] ["circle"]
      if away? [ set shape "square" ]
      set label ifelse-value show-balances?
        [(word (precision (available true) 1) "/" (precision (available false) 1))] [""]
    ]
    ask transfers with [not external?] [
      let counterparty partner
      let caption (word (precision quantity 1) " @" due-tick)
      ask requester [
        create-trade-route-to counterparty [
          set color [245 190 65]
          set thickness 0.25
          set label caption
          set label-color white
        ]
      ]
    ]
  ]
end

to check-accounting
  with-local-randomness [
    if any? kiosks with [reserved-cash < -0.000001 or reserved-efloat < -0.000001 or
      available true < -0.000001 or available false < -0.000001] [
      error "Negative or overcommitted kiosk balance."
    ]
    if abs (sum [cash] of kiosks - initial-cash - net-customer-cash - net-external-cash - subsidy-spent) > 0.000001 or
      abs (sum [efloat] of kiosks - initial-efloat + net-customer-cash + net-external-cash) > 0.000001 [
      error "Market balances do not reconcile with customer, external and subsidy flows."
    ]
    let peer-pending transfers with [not external?]
    let external-pending transfers with [external?]
    let expected-cash sum [quantity] of peer-pending + sum [requester-fee] of peer-pending with [not cash-needed?] +
      sum [quantity] of external-pending with [not cash-needed?]
    let expected-efloat sum [quantity] of peer-pending + sum [quantity] of external-pending with [cash-needed?]
    if initiated-count - settled-count != count peer-pending or
      external-started - external-settled != count external-pending or
      abs (sum [reserved-cash] of kiosks - expected-cash) > 0.000001 or
      abs (sum [reserved-efloat] of kiosks - expected-efloat) > 0.000001 [
      error "Pending trades and reservations do not reconcile."
    ]
    if abs (commissions-earned - commissions-paid - subsidy-spent) > 0.000001 or
      abs (commissions-earned - sum [earned-commissions] of kiosks) > 0.000001 or
      abs (commissions-paid - sum [paid-commissions] of kiosks) > 0.000001 [
      error "Commission income, requester payments and subsidy spending do not reconcile."
    ]
    if requested-count != served-count + closure-failed-count + cash-failed-count + efloat-failed-count [
      error "Customer request outcomes do not reconcile."
    ]
    if any? kiosks with [pending-transfer != nobody and not member? self [requester] of transfers and
      not member? self [partner] of peer-pending] [ error "Orphaned pending trade." ]
  ]
end
